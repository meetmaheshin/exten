# ═══════════════════════════════════════════════════
# Ailancers Code - Environment Configuration
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════

# ─── Server ───
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# ─── Database (PostgreSQL) ───
POSTGRES_USER=ailancers
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=ailancers
DATABASE_URL=postgresql://ailancers:CHANGE_ME_strong_password_here@postgres:5432/ailancers

# ─── Redis ───
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379

# ─── Authentication ───
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── Anthropic Claude API ───
# Get your API key from: https://console.anthropic.com/settings/keys
# THIS is where you set the AI key — developers never see this
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096

# ─── OpenAI (optional — leave empty to disable) ───
# If you also want to offer GPT models alongside Claude
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# ─── Agent Mode ───
# Max tokens per agent turn (higher = Claude can write more code per turn)
AGENT_MAX_TOKENS=16384
# Max turns in a single agent session (prevents runaway loops)
AGENT_MAX_TURNS=50

# ─── Rate Limits ───
# Max AI requests per developer per minute
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_TELEMETRY_PER_MINUTE=10

# ─── Budget ───
# Default monthly AI budget per developer (USD)
DEFAULT_MONTHLY_BUDGET_USD=50.00

# ─── CORS ───
# Comma-separated list of allowed origins (your dashboard URL)
CORS_ORIGINS=https://admin.yourdomain.com

# ─── Screenshots ───
SCREENSHOT_STORAGE_DIR=/app/data/screenshots
SCREENSHOT_MAX_SIZE_MB=5

# ─── Dashboard ───
# The public URL where your backend API is accessible
PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# ─── Docker Ports ───
BACKEND_PORT=3000
DASHBOARD_PORT=3001
